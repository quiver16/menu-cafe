{
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "./src",
        "lib": ["ESNext"],
        "target": "ES2022",
        "moduleResolution": "NodeNext", // Changed from 'bundler'
        "module": "NodeNext",           // Changed from 'esnext'
        "strict": false,
        "sourceMap": true,
        "esModuleInterop": true,
        "declaration": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"]
}